# Domains (DNS A/AAAA-Records auf die Instanz). www. und app. leiten auf APP_DOMAIN um (Caddyfile)
APP_DOMAIN=wartungsheft.ch
AI_PROXY_DOMAIN=ai.wartungsheft.ch

# Mistral (Scale-Tier, kein Training)
MISTRAL_API_KEY=

# InstantDB self-hosted (offizieller VPS-Guide in /opt/instant), Admin-Token aus dem Instant-Dashboard der App
INSTANT_API_URI=https://api.wartungsheft.ch
INSTANT_APP_ID=
INSTANT_ADMIN_TOKEN=
# Docker-Netz des InstantDB-Stacks (Compose-Projekt "instant"), darin erreicht dessen Caddy den Proxy
INSTANT_NETWORK=instant_default

# Stripe (optional, ohne diese Werte antworten /billing/* mit 501)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# Jahresrechnung für Betriebe (QR-Rechnung). IBAN des Geschäftskontos, QR-IBAN ergibt QR-Referenzen, sonst SCOR.
# Ohne INVOICE_IBAN ist die Bestellung aus (501). Ohne RESEND_TOKEN wird die Rechnung nur protokolliert.
INVOICE_IBAN=
INVOICE_CREDITOR_NAME=Goran Strainovic
INVOICE_TRADE_NAME=Strainovic IT
INVOICE_BRAND=Wartungsheft
INVOICE_STREET=Bahnstrasse 9b
INVOICE_ZIP=9323
INVOICE_CITY=Steinach
INVOICE_EMAIL=info@wartungsheft.ch
INVOICE_WEBSITE=wartungsheft.ch
INVOICE_FROM=Wartungsheft <rechnung@wartungsheft.ch>
# Derselbe Resend-Schlüssel wie für Magic Codes und Erinnerungen
RESEND_TOKEN=
# Geheimnis für den Abo-Job (openssl rand -hex 32)
AI_PROXY_INTERNAL_TOKEN=
