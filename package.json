{
  "name": "auto-service",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:vite": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test --project=online --project=offline",
    "test:e2e:soft": "playwright test --project=ai-soft",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "dev:proxy": "node --env-file-if-exists=.env node_modules/@strainovic/ai-proxy/src/node.ts"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^3.0.17",
    "@instantdb/core": "^0.22.121",
    "@primeuix/themes": "^2.0.3",
    "@strainovic/ai-proxy": "file:../ai-proxy",
    "ai": "^6.0.63",
    "dompurify": "^3.3.1",
    "marked": "^17.0.1",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "tesseract.js": "^7.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@playwright/test": "^1.58.1",
    "@types/node": "^24.10.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "sass-embedded": "^1.97.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.4"
  }
}
