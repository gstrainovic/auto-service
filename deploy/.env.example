# Domains (DNS A-Records auf die VM)
APP_DOMAIN=app.example.ch
AI_PROXY_DOMAIN=ai.example.ch

# Mistral (Scale-Tier, kein Training)
MISTRAL_API_KEY=

# InstantDB self-hosted (offizieller VPS-Guide), Admin-Token aus dem Instant-Dashboard der App
INSTANT_API_URI=https://api.example.ch
INSTANT_APP_ID=
INSTANT_ADMIN_TOKEN=

# Stripe (optional, ohne diese Werte antworten /billing/* mit 501)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
