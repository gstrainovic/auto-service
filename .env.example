# Frontend (Vite, Build-Zeit)
# VITE_INSTANTDB_MODE: leer = cloud (Auslaufmodell), local = E2E, selfhosted = eigener Server
VITE_INSTANTDB_MODE=selfhosted
VITE_INSTANT_APP_ID=
VITE_INSTANT_API_URI=https://api.example.ch
VITE_INSTANT_WS_URI=wss://api.example.ch/runtime/session
# AI-Proxy (Pflicht, der Browser sieht nie einen Mistral-Key)
VITE_AI_PROXY_URL=https://ai.example.ch

# AI-Proxy lokal (npm run dev:proxy startet ihn aus node_modules/@strainovic/ai-proxy, E2E). Achtung: eine in der Shell exportierte MISTRAL_API_KEY
# hätte Vorrang vor dieser Datei (Node --env-file überschreibt vorhandene Variablen nicht)
MISTRAL_API_KEY=
INSTANT_API_URI=http://localhost:8888
INSTANT_APP_ID=cd7e6912-773b-4ee1-be18-4d95c3b20e9f
INSTANT_ADMIN_TOKEN=
AI_PROXY_AUTH_BYPASS=1
