# Hosts der PWA und des AI-Proxys. Wird vom Caddy des InstantDB-Stacks (/opt/instant) per
# `import /etc/caddy/sites/*.caddy` geladen, dieselbe Caddy-Instanz bedient api./dash./files.
# Der AI-Proxy hängt dafür im Docker-Netz des InstantDB-Stacks (siehe docker-compose.yml).

{$APP_DOMAIN} {
	root * /srv/app
	encode gzip
	try_files {path} /index.html
	file_server
	header {
		# PWA: Service Worker und Manifest nicht aggressiv cachen
		Cache-Control "public, max-age=0, must-revalidate"
	}
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# Rechtsseiten nicht in Suchmaschinen: niemand sucht sie, und indexiert ziehen sie Abmahnanwälte an
	@legal path /agb /datenschutz /impressum
	header @legal X-Robots-Tag "noindex, nofollow"
	# Besucherzahlen für die Validierung (business-plan/09, M3), kein Analytics-Dienst, keine Cookies.
	# 30 Tage Aufbewahrung wie in der Datenschutzerklärung: rotierte Dateien löscht Caddy (roll_keep_for),
	# die aktive Datei kürzt /opt/backup/backup.sh täglich, weil Caddy nur nach Grösse rotiert.
	log {
		output file /data/access-app.log {
			roll_size 20mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}

# Kurzformen leiten auf die Hauptdomain
www.{$APP_DOMAIN}, app.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

{$AI_PROXY_DOMAIN} {
	reverse_proxy ai-proxy:8787
}
